# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is gitignored — never commit secrets or local database paths.

# -----------------------------------------------------------------------------
# Database (SQLAlchemy connection string — primary config source)
# -----------------------------------------------------------------------------
# Local SQLite (default dev file at repo root if unset):
DQE_DATABASE_URL=sqlite:///./phase2_dev.db

# Production PostgreSQL example:
# DQE_DATABASE_URL=postgresql://user:password@localhost:5432/dqe

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Passed to init_db_session at startup (development | production)
ENVIRONMENT=development

# Comma-separated browser origins for CORS, or * for local dev
DQE_CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Required for stable sessions across server restarts — if unset, a random
# secret is generated on each boot and existing tokens become invalid.
DQE_JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime in hours
DQE_JWT_TTL_HOURS=24

# -----------------------------------------------------------------------------
# AI explanations (optional)
# -----------------------------------------------------------------------------
# Reports and Inspect buttons still work without a key — they use rich
# rule-based fallbacks instead of Gemini-generated text.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_RPM_LIMIT=8
GEMINI_MAX_RETRIES=3
GEMINI_MAX_RETRY_DELAY_SECONDS=8
