# Leave unset for local dev — vite.config.js proxies /api/* to the backend
# (default http://127.0.0.1:8000) so the browser never even needs CORS.
#
# For a production build (`npm run build`), set this to your deployed
# FastAPI origin, and make sure CORSMiddleware is enabled there (see
# ../backend_patches/README.md).
# VITE_API_BASE_URL=https://api.yourcompany.com

# Only needed if your backend runs somewhere other than 127.0.0.1:8000
# during `npm run dev`.
# VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
